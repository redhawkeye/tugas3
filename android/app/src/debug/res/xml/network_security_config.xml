<?xml version="1.0" encoding="utf-8"?>
<!-- Hanya berlaku untuk build debug: percayai sertifikat CA yang dipasang
     pengguna (mis. VPN/proxy kantor yang memeriksa HTTPS). Build release
     tidak terpengaruh. -->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
